<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tm="clr-namespace:TextMateSharp.Grammars;assembly=TextMateSharp.Grammars">
  <!--
    Markdown 预览（LiveMarkdown.Avalonia）的配色。
    库自带的 Defaults.axaml 只有深色配色，这里提供浅色 / 深色两套。
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="ForegroundColor">#E4000000</Color>
      <Color x:Key="BorderColor">#1F000000</Color>
      <Color x:Key="CardBackgroundColor">#05000000</Color>
      <Color x:Key="SecondaryCardBackgroundColor">#0B000000</Color>
      <Color x:Key="CodeInlineColor">#B42357</Color>
      <Color x:Key="QuoteBorderColor">#2F6FED</Color>
      <tm:ThemeName x:Key="MarkdownCodeTheme">LightPlus</tm:ThemeName>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="ForegroundColor">#FFFFFFFF</Color>
      <Color x:Key="BorderColor">#33FFFFFF</Color>
      <Color x:Key="CardBackgroundColor">#08FFFFFF</Color>
      <Color x:Key="SecondaryCardBackgroundColor">#14FFFFFF</Color>
      <Color x:Key="CodeInlineColor">#F48FB1</Color>
      <Color x:Key="QuoteBorderColor">#6EA0FF</Color>
      <tm:ThemeName x:Key="MarkdownCodeTheme">DarkPlus</tm:ThemeName>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="FontSizeS">12.8</x:Double>
  <x:Double x:Key="FontSizeM">14</x:Double>
  <x:Double x:Key="FontSizeL">15</x:Double>
  <x:Double x:Key="FontSizeXl">18</x:Double>
  <x:Double x:Key="FontSize2Xl">22</x:Double>
  <x:Double x:Key="FontSize3Xl">28</x:Double>
</ResourceDictionary>
