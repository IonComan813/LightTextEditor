<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives">

  <!-- Markdown 预览的样式在 MarkdownStyles.axaml，第一次打开预览时才加载（见 App.EnsureMarkdownResources） -->

  <Styles.Resources>
    <!-- 标记：App.EnsureMarkdownResources 据此把 Markdown 预览的样式插在本文件之前 -->
    <x:String x:Key="LteAppStylesMarker">AppStyles</x:String>
    <!-- 标签页关闭按钮：自己的模板，悬停高亮不受标签页选中状态的样式影响 -->
    <ControlTheme x:Key="LteTabCloseButton" TargetType="Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="6,0,-2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Background" Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- 标签使用自己的关闭按钮（见 Views/DocumentTab.cs） -->
  <Style Selector="ui|FATabViewItem">
    <Setter Property="IsClosable" Value="False" />
  </Style>

  <!-- ───── 标签页标题：当前标签加粗，其他标签颜色浅一些 ───── -->
  <!-- 用 Bold 而不是 SemiBold：微软雅黑等中文字体没有半粗字重，SemiBold 会显示成常规粗细 -->
  <Style Selector="TextBlock.tabTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="ui|FATabViewItem:selected TextBlock.tabTitle">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!--
    ───── 标签页上的关闭按钮 ─────
    - 当前标签页：显示 ×；有未保存更改时显示 ●，鼠标移到 ● 上变成 ×
    - 其他标签页：平时不显示 ×（鼠标移到该标签上时才显示）；有未保存更改时显示 ●
    - ● 使用浅一些的颜色
  -->
  <Style Selector="Button.tabClose">
    <Setter Property="Theme" Value="{StaticResource LteTabCloseButton}" />
  </Style>
  <Style Selector="Button.tabClose Path.closeGlyph">
    <Setter Property="Data" Value="M0,0 L7,7 M7,0 L0,7" />
    <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.tabClose Ellipse.dirtyDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.tabClose.dirty Path.closeGlyph">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.tabClose.dirty Ellipse.dirtyDot">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.tabClose.dirty:pointerover Path.closeGlyph">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.tabClose.dirty:pointerover Ellipse.dirtyDot">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- 非当前、未修改、鼠标也不在上面的标签：隐藏 ×（保留占位，标签宽度不跳动） -->
  <Style Selector="ui|FATabViewItem:not(:selected):not(:pointerover) Button.tabClose:not(.dirty)">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!--
    标签栏用普通的 StackPanel（FluentAvalonia 默认是 VirtualizingStackPanel）：
    虚拟化会卸掉滚出视野的标签，窗口变宽后不一定重新生成，标签就“消失”了；标签不多，不需要虚拟化。
  -->
  <Style Selector="uip|FATabViewListView">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <!-- 状态栏上的扁平按钮 -->
  <Style Selector="Button.statusItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.statusItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="2,6" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- 灰色但仍可选择的菜单项（如“换一个编码”里已经试过的编码） -->
  <Style Selector="MenuItem.dimmed">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>

  <!-- 菜单栏紧凑一些 -->
  <Style Selector="Menu.mainMenu > MenuItem">
    <Setter Property="Padding" Value="10,4" />
  </Style>
</Styles>
